{
  "teammateMode": "in-process",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/block-admin-bypass.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/git-guardrails.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git status:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git rm:*)",
      "Bash(git ls-files:*)",
      "Bash(gh pr:*)",
      "Bash(gh api:*)",
      "Bash(gh workflow:*)",
      "Bash(./scripts/validate.sh)",
      "Bash(./scripts/spotless-apply.sh)",
      "Bash(./scripts/format.sh)",
      "Bash(./scripts/prepare-for-commit.sh)",
      "Bash(./scripts/run-e2e-debug-flow.sh)",
      "Bash(./scripts/restart_server.sh)",
      "Bash(./scripts/analyze-*.sh:*)",
      "Bash(bd:*)",
      "Bash(./gradlew:*)",
      "Bash(docker:*)",
      "Bash(terraform:*)",
      "Bash(aws:*)",
      "Bash(open:*)",
      "Bash(adb:*)",
      "Bash(grpcurl:*)",
      "Bash(xcodebuild:*)",
      "Bash(grep:*)",
      "Bash(cd:*)",
      "Read(**/*)",
      "Edit(**/*)",
      "Write(**/*)",
      "Glob(**/*)",
      "Grep(**/*)"
    ]
  }
}
