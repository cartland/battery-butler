{
  "teammateMode": "in-process",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/protect-beads-files.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/protect-beads-files.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/block-admin-bypass.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/git-guardrails.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/protect-beads-files.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git rm *)",
      "Bash(git ls-files *)",
      "Bash(gh *)",
      "Bash(./scripts/validate.sh)",
      "Bash(./scripts/spotless-apply.sh)",
      "Bash(./scripts/format.sh)",
      "Bash(./scripts/prepare-for-commit.sh)",
      "Bash(./scripts/run-e2e-debug-flow.sh)",
      "Bash(./scripts/build-ios.sh)",
      "Bash(./scripts/test-ios.sh *)",
      "Bash(./scripts/test-ios.sh)",
      "Bash(./scripts/sync-ios-project.sh)",
      "Bash(./scripts/restart_server.sh)",
      "Bash(./scripts/analyze-* *)",
      "Bash(bd *)",
      "Bash(./gradlew *)",
      "Bash(docker *)",
      "Bash(terraform *)",
      "Bash(aws *)",
      "Bash(open *)",
      "Bash(adb *)",
      "Bash(grpcurl *)",
      "Bash(xcodebuild *)",
      "Bash(./scripts/generate-protos.sh *)",
      "Bash(./scripts/generate-screenshots-sequentially.sh *)",
      "Bash(./scripts/generate-android-screenshot-gallery.sh *)",
      "Bash(./scripts/generate-ios-screenshot-gallery.sh *)",
      "Bash(./scripts/record-ios-snapshots.sh *)",
      "Bash(./scripts/validate-ios-screenshots.sh)",
      "Bash(./scripts/validate-generated.sh *)",
      "Bash(./scripts/embed-mermaid.sh)",
      "Bash(./scripts/deploy-status.sh *)",
      "Bash(./scripts/e2e-tests.sh *)",
      "Bash(bazel *)",
      "Bash(python3 *)",
      "Bash(nc *)",
      "Bash(GIT_EDITOR=true git rebase *)",
      "WebSearch",
      "Bash(grep *)",
      "Bash(cd *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(pwd)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(echo *)",
      "Bash(stat *)",
      "Bash(file *)",
      "Bash(which *)",
      "Bash(type *)",
      "Bash(jq *)",
      "Bash(xargs *)",
      "Bash(awk *)",
      "Bash(sed *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(mkdir *)",
      "Bash(chmod *)",
      "Bash(ruby *)",
      "Read(**/*)",
      "Edit(**/*)",
      "Write(**/*)",
      "Glob(**/*)",
      "Grep(**/*)"
    ]
  }
}
