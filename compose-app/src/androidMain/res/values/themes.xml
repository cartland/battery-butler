<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Splash theme used during app cold-start. Hands off to the regular
        Material theme once the activity calls installSplashScreen() and the
        first composable frame is ready.
    -->
    <style name="Theme.BatteryButler.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_round</item>
        <item name="postSplashScreenTheme">@android:style/Theme.Material.Light.NoActionBar</item>
    </style>

</resources>
