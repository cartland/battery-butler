<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ data-extraction policy.
    Mirrors android:allowBackup="false" (kept for pre-Android 12 devices):
    no files are eligible for cloud backup or device-to-device transfer.

    https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="false">
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
